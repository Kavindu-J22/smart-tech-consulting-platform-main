# Copy to .env.local and fill in. Never commit real values.

# Database (Phase 2). Locally both come from `npx prisma dev`.
DATABASE_URL=
DIRECT_URL=

# Login (Phase 3). Secret: run `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Document uploads (Phase 6). From the Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Knowledge base (RAG, later). From the Pinecone console.
PINECONE_API_KEY=
PINECONE_INDEX=

# Product module RAG. Embeddings from OpenAI; vectors in the shared Pinecone index.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
